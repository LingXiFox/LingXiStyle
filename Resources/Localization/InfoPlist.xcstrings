    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于把补好纹理与颗粒的照片存为相册中的新照片，原照片不会被修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於將補好紋理與顆粒的照片存為相簿中的新照片，原照片不會被修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the textured photo as a new photo in Photos. The original is never modified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テクスチャと粒子を追加した写真を写真アプリに新しい写真として保存します。元の写真は変更されません。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于读取你选择的 HEIC 原片，并在本机追加纹理与颗粒。照片不会离开设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於讀取你選擇的 HEIC 原片，並在本機附加紋理與顆粒。照片不會離開裝置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the HEIC original you select and adds texture and grain on this device. Photos never leave your device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した HEIC 原本を読み取り、このデバイス上でテクスチャと粒子を追加します。写真がデバイスの外に出ることはありません。"
          }
        }
      }
    }
  },
  "version": "1.0"
}

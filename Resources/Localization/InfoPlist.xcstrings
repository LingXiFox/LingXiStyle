    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the textured photo as a new photo in Photos. The original is never modified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質感を追加した写真を写真アプリに新しい写真として保存します。元の写真は変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于把补好质感的照片存为相册中的新照片，原照片不会被修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於將補好質感的照片存為相簿中的新照片，原照片不會被修改。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the HEIC original you choose and adds third-generation texture on this device. Photos never leave your device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した HEIC 原本を読み取り、このデバイス上で第3世代の質感を追加します。写真がデバイスの外に出ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于读取你选择的 HEIC 原片，并在本机追加第三代质感。照片不会离开设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於讀取你選擇的 HEIC 原片，並在本機追加第三代質感。照片不會離開裝置。"
          }
        }
      }
    }
  },
  "version": "1.0"
}

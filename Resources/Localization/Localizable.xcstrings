    "pro.trial.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One claim per new user. The clock starts when you claim; no subscription, no charge. It reverts to the free limit afterwards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規ユーザーは 1 回だけ受け取れます。受け取った時点からカウントされ、サブスク登録も課金もありません。終了後は無料枠に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每位新用户可领取一次，从确认领取开始计时，不订阅、不扣费。到期后回到免费额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每位新使用者可領取一次，從確認領取開始計時，不訂閱、不扣費。到期後回到免費額度。"
          }
        }
      }
    },
    "pro.trial.claim": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claim free trial"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料体験を受け取る"
          }
        },
        "zh-Hans": {

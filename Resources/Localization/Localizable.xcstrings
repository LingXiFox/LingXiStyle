    "mac.convert.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop HEIC originals shot on iPhone. Texel only adds a layer of texture and grain — no transcoding, no overwriting, no uploads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで撮影したHEICの元画像をドロップ。紋粒は質感と粒子を加えるだけで、変換・上書き・アップロードは行いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入 iPhone 拍摄的 HEIC 原片。纹粒只会追加一层纹理与颗粒，不转码、不覆盖原片、不上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入 iPhone 拍攝的 HEIC 原片。紋粒只會追加一層紋理與顆粒，不轉碼、不覆蓋原片、不上傳。"
          }
        }
      }
    },
    "mac.convert.dropHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-select and whole folders are supported. For Live Photos, drop the matching .MOV from the same folder too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数選択とフォルダ単位の読み込みに対応。ライブフォトは同じフォルダの同名 .MOV も一緒にドロップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持多选和整个文件夹。实况照片请把同目录同名的 .MOV 一起拖入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援多選和整個資料夾。實況照片請把同目錄同名的 .MOV 一起拖入。"
          }
        }
      }
    },

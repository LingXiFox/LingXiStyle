          "stringUnit": {
            "state": "translated",
            "value": "The photo is already in Photos, so there’s no need to retry. Open Photos to confirm the resource type."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はすでに写真アプリに書き込まれています。再試行は不要です。「写真」でリソースの種類を確認できます。"

      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纹粒只给 HEIC 原片追加纹理与颗粒，再另存一张新照片。像素不重绘、不转码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Texel adds texture and grain to a HEIC original and saves a new photo. Pixels are never redrawn or transcoded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テクセルは HEIC 原本にテクスチャと粒子を加え、新しい写真として保存します。画素の再描画や再エンコードはしません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紋粒只為 HEIC 原片加入紋理與顆粒，再另存一張新照片。像素不重繪、不轉碼。"
          }
        }
      }
    },
    "tutorial.step.styles.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄影风格，还能继续调"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographic Styles stay editable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォトグラフスタイルは後から調整可能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "攝影風格，還能繼續調"
          }
        }
      }
    },
    "tutorial.step.styles.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 16 / 17 的摄影风格能调强度与纹理颗粒，第二代、第三代风格都适用。新照片之后仍可回到这里继续调。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone 16 and 17, Photographic Styles adjust intensity, texture, and grain — on second- and third-generation styles alike. You can come back and keep tuning the new photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 16 / 17 のフォトグラフスタイルでは、強さ・テクスチャ・粒子を調整できます。第2世代・第3世代のスタイルに対応。新しい写真も後から調整できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 16 / 17 的攝影風格能調強度與紋理顆粒，第二代、第三代風格都適用。新照片之後仍可回到這裡繼續調。"
          }
        }
      }
    },
    "tutorial.step.compatibility.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些照片能处理"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What works"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使える写真"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些照片能處理"
          }
        }
      }
    },
    "tutorial.step.compatibility.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 16 / 17 的 HEIC 最合适。非 HEIF、RAW、已带纹理，或缺少配对视频的实况照片会跳过，并说明原因。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC from iPhone 16 and 17 works best. Non-HEIF, RAW, already-textured photos, and Live Photos without a paired movie are skipped with a reason."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 16 / 17 の HEIC が最適です。HEIF 以外、RAW、すでにテクスチャ付き、対になる動画がないライブフォトは理由を表示してスキップします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 16 / 17 的 HEIC 最合適。非 HEIF、RAW、已帶紋理，或缺少配對影片的實況照片會略過，並說明原因。"
          }
        }
      }
    },
    "tutorial.step.compatibility.note": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享相册里的照片，先保存到图库再试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos in Shared Albums need to be saved to your library first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有アルバムの写真は、先にライブラリへ保存してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享相簿裡的照片，先儲存到圖庫再試。"
          }
        }
      }
    },
    "tutorial.step.pick.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选照片，点开始"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick photos, then start"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を選んで開始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選照片，點開始"
          }
        }
      }
    },
    "tutorial.step.pick.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从图库选 HEIC 或实况照片，也可以从「文件」导入。点「添加纹理与颗粒」，读取、追加、校验、保存都会真实显示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose HEIC or Live Photos from your library, or import from Files. Tap “Add texture and grain” — reading, adding, verifying, and saving are all shown for real."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリから HEIC やライブフォトを選ぶか、「ファイル」から読み込みます。「テクスチャと粒子を追加」をタップすると、読み込み・追加・検証・保存が実際に表示されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從圖庫選 HEIC 或實況照片，也可以從「檔案」匯入。點「加入紋理與顆粒」，讀取、附加、校驗、儲存都會真實顯示。"
          }
        }
      }
    },
    "tutorial.step.livePhoto.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实况照片，只算一张"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos count once"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブフォトも 1 枚分"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實況照片，只算一張"
          }
        }
      }
    },
    "tutorial.step.livePhoto.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只处理主帧更快；完整处理会让动态画面也带上同样的质感。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still only is faster. Full processing gives the motion the same look too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインのコマだけなら速く終わります。完全処理なら動画にも同じ質感が付きます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只處理主幀更快；完整處理會讓動態畫面也帶上同樣的質感。"
          }
        }
      }
    },
    "tutorial.step.result.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新照片在哪里"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the new photo goes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい写真の保存先"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新照片在哪裡"
          }
        }
      }
    },
    "tutorial.step.result.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成后打开「照片」→「最近项目」，文件名带 _Texel。原图、原实况照片和已有编辑都不会被覆盖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Photos → Recents; the name ends in _Texel. Originals, original Live Photos, and existing edits stay untouched."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了後は「写真」→「最近の項目」を開きます。ファイル名に _Texel が付きます。元の写真、元のライブフォト、既存の編集は上書きされません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成後開啟「照片」→「最近項目」，檔名帶 _Texel。原圖、原實況照片和既有編輯都不會被覆蓋。"
          }
        }
      }
    },
    "tutorial.step.edit.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想再调风格"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tune the style later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイルは後から調整"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想再調風格"
          }
        }
      }
    },
    "tutorial.step.edit.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开新照片 → 编辑 → 摄影风格，拖动强度滑块，纹理与颗粒会一起变化。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the new photo → Edit → Photographic Styles. Drag the intensity slider; texture and grain move with it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい写真を開く → 編集 → フォトグラフスタイル。強さのスライダーを動かすと、テクスチャと粒子も一緒に変わります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟新照片 → 編輯 → 攝影風格，拖動強度滑桿，紋理與顆粒會一起變化。"
          }
        }
      }
    },
    "tutorial.step.invisible.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看不出变化？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks unchanged?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変化が見えない？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看不出變化？"
          }
        }
      }
    },
    "tutorial.step.invisible.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纹理与颗粒是单独一层，缩略图和部分旧系统会忽略它。放大查看，或进入编辑面板就能看到。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Texture and grain are a separate layer; thumbnails and some older systems ignore it. Zoom in, or open the edit panel to see it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テクスチャと粒子は別レイヤーで、サムネイルや一部の古いシステムでは無視されます。拡大するか編集パネルを開くと確認できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紋理與顆粒是單獨一層，縮圖和部分舊系統會忽略它。放大查看，或進入編輯面板就能看到。"
          }
        }
      }
    },
    "tutorial.step.quota.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额度与 Pro"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quota and Pro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "枠と Pro"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "額度與 Pro"
          }
        }
      }
    },
    "tutorial.step.quota.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天 5 张免费额度，成功保存才扣 1 张；每张实况照片也只算 1 张。Pro 一次购买，永久不限张数。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five free photos a day, charged only after a successful save. Each Live Photo counts once. Pro is one purchase, unlimited photos forever."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料枠は 1 日 5 枚。保存に成功したときだけ 1 枚消費します。ライブフォトも 1 枚分です。Pro は買い切りで、ずっと枚数無制限です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天 5 張免費額度，成功儲存才扣 1 張；每張實況照片也只算 1 張。Pro 一次購買，永久不限張數。"
          }
        }
      }
    },

    "share.copyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is copied into %@’s sandbox before its structure is checked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはまず %@ のサンドボックスにコピーされ、その後で構造を確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会先复制到 %@ 的沙盒，再检查结构。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會先複製到 %@ 的沙盒，再檢查結構。"
          }
        }
      }
    },
    "share.error.noAccess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share extension couldn’t get read/write access. Select the photo from your library in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有拡張機能がファイルの読み書き権限を取得できません。%@ 内でライブラリから写真を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享扩展没有拿到文件的读写权限。请在 %@ 内从图库选择照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享擴充套件沒有取得檔案的讀寫權限。請在 %@ 內從圖庫選擇照片。"
          }
        }
      }
    },
    "share.error.noFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system didn’t provide a readable copy. Select the photo from your library in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが読み取り可能なコピーを提供しませんでした。%@ 内でライブラリから写真を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统没有提供可读取的文件副本。请直接在 %@ 内从图库选择照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統沒有提供可讀取的檔案副本。請直接在 %@ 內從圖庫選擇照片。"
          }
        }
      }
    },
    "share.error.noProviders": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share again from Photos, or select the photo from your library in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」から共有し直すか、%@ 内でライブラリから写真を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请回到系统「照片」重新分享，或直接在 %@ 内从图库选择照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請回到系統「照片」重新分享，或直接在 %@ 內從圖庫選擇照片。"
          }
        }
      }
    },
    "share.error.notHEIC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share a HEIC original, or select the photo from your library in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC 原本を共有するか、%@ 内でライブラリから写真を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请分享一张 HEIC 原片，或直接在 %@ 内从图库选择照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請分享一張 HEIC 原片，或直接在 %@ 內從圖庫選擇照片。"
          }
        }
      }
    },
    "share.error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system didn’t return the photo in time. Share again from Photos, or select the photo from your library in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが制限時間内に写真を返しませんでした。「写真」から共有し直すか、%@ 内でライブラリから写真を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统没有在限定时间内返回照片。请返回系统「照片」重新分享，或直接在 %@ 内从图库选择照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統沒有在限定時間內傳回照片。請返回系統「照片」重新分享，或直接在 %@ 內從圖庫選擇照片。"
          }
        }
      }
    },
    "share.error.unsupportedDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the photo from your library in %@. The share sheet sometimes sends a JPEG or preview, which can’t preserve the original encoding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 内でライブラリから写真を選択してください。共有シートが JPEG やプレビューに変換すると、元の符号化を保持できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 %@ 内从图库选择照片。分享面板有时会转成 JPEG 或只给出预览图，这时无法保留原始编码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 %@ 內從圖庫選擇照片。分享面板有時會轉成 JPEG 或只給出預覽圖，這時無法保留原始編碼。"
          }
        }
      }
    },
    "share.quotaHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free quota resets at 00:00 local time. You can also open %@ to learn about Texel Pro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料枠は現地時間 0:00 にリセットされます。%@ で Texel Pro もご覧いただけます。"

          "stringUnit": {
            "state": "translated",
            "value": "只影响这批里的 %lld 张实况照片；其余照片不受影响。默认值可以在设置里修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only to the %lld Live Photos in this batch; other photos are unaffected. You can change the default in Settings."
          }

    "batch.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You selected %lld photos that can be processed and have %lld free photos left today. The rest won’t be processed and won’t use quota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 枚の処理可能な写真を選択しました。本日の無料枠は残り %lld 枚です。超過分は処理されず、枠も消費しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选 %lld 张可处理照片，今日还剩 %lld 张免费额度。超出部分不会处理，也不会消耗额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選 %lld 張可處理照片，今日還剩 %lld 張免費額度。超出部分不會處理，也不會消耗額度。"
          }
        }
      }
    },

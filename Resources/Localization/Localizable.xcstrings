    "mac.settings.styleNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a file exported from Photos already has a photographic style applied, Texel flags it during inspection instead of rewriting it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」から書き出したファイルに撮影スタイルが適用済みの場合、紋粒は確認段階で通知し、強制的に書き換えません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从「照片」导出的文件如果已经应用了摄影风格，纹粒会在检查阶段提示，不会强行改写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「照片」匯出的檔案如果已經套用攝影風格，紋粒會在檢查階段提示，不會強行改寫。"
          }
        }
      }
    },
    "mac.settings.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are processed on this Mac only: no uploads, no transcoding, no overwriting. The vault and task records stay in the local app data folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はこのMac内だけで処理します。アップロード・変換・上書きは行いません。保管庫とタスク記録はローカルのアプリデータに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片只在本机处理：不上传、不转码、不覆盖原片。保险箱与任务记录保存在本机的应用数据目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片只在本機處理：不上傳、不轉碼、不覆蓋原片。保險箱與任務記錄保存在本機的應用資料目錄。"
          }
        }
      }
    },
    "mac.vault.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished results stay here for a while. Re-saving or exporting never uses allowance again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換した成果はしばらくここに保存されます。再保存や書き出しで枠を消費することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转换完成的结果会在这里保留一段时间。重新保存或导出都不会再扣额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉換完成的結果會在這裡保留一段時間。重新儲存或匯出都不會再扣額度。"
          }
        }
      }
    },
    "mac.vault.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converted photos stay here, for as long as the retention you choose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換した写真はここに保存され、選択した期間だけ保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转换完成的照片会留在这里，最多按你所选的期限保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉換完成的照片會留在這裡，最多按你所選的期限儲存。"
          }
        }
      }
    },
    "mac.quota.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quota unavailable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

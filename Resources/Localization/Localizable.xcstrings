    "share.error.noAccess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share extension couldn’t get read/write access. Select the photo from your library in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有拡張機能がファイルの読み書き権限を取得できません。%@ 内でライブラリから写真を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

    "主照片获得纹理与颗粒，动态画面和声音保持原样。速度最快，也最稳妥。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主照片获得纹理与颗粒，动态画面和声音保持原样。速度最快，也最稳妥。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The still gets texture and grain; motion and sound stay as they were. Fastest and safest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静止画にテクスチャと粒子を加え、動画と音声はそのまま残します。最も速く、確実です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主照片獲得紋理與顆粒，動態畫面與聲音保持原樣。速度最快，也最穩妥。"
          }
        }
      }
    },
    "主照片和动态画面的每一帧获得同样的纹理与颗粒，声音、关键帧与配对关系保留。处理时间更长。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主照片和动态画面的每一帧获得同样的纹理与颗粒，声音、关键帧与配对关系保留。处理时间更长。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The still and every motion frame get the same texture and grain; sound, keyframes and pairing are preserved. Takes longer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静止画と動画の全フレームに同じテクスチャと粒子を加えます。音声、キーフレーム、ペア情報は保持されます。処理時間は長くなります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主照片和動態畫面的每一幀獲得同樣的紋理與顆粒，聲音、關鍵影格與配對關係保留。處理時間更長。"
          }
        }
      }
    },

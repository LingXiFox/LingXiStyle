    "mac.history.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every conversion leaves a record: count, state and failure reasons. Tasks interrupted by a quit are reconciled on next launch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換ごとに記録が残ります：枚数・状態・失敗理由。終了で中断したタスクは次回起動時に補記されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次转换都留一条记录：张数、状态和失败原因。退出后中断的任务会在下次启动时补记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次轉換都留一條記錄：張數、狀態和失敗原因。退出後中斷的任務會在下次啟動時補記。"
          }
        }
      }
    },
    "mac.pro.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited photos, plus the vault and task history — processing stays identical to the free version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "枚数無制限、保管庫とタスク履歴も利用可能。処理内容は無料版と同じです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不限张数、保留保险箱与任务历史，处理方式与免费版完全一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不限張數、保留保險箱與任務歷史，處理方式與免費版完全一致。"
          }
        }
      }
    },
    "mac.pro.trialBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each device can claim one 24-hour trial: no subscription, no charge, counted from the moment you claim it, back to the free allowance afterwards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスごとに1回、24時間トライアルを受け取れます。サブスク不要・課金なし、受け取り時点から計測し、終了後は無料枠に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台设备可以领取一次 24 小时体验：不订阅、不扣费，从确认领取开始计时，到期后回到免费额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每台裝置可以領取一次 24 小時體驗：不訂閱、不扣費，從確認領取開始計時，到期後回到免費額度。"
          }
        }
      }
    },
    "mac.pro.legal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly and monthly plans renew automatically and can be cancelled anytime in Manage Subscription; day passes and the lifetime plan are one-time purchases. Prices are shown by the App Store per region."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週額・月額プランは自動更新で、「サブスクリプションを管理」からいつでも解約できます。1日パスと永久版は買い切りです。価格はApp Storeが地域ごとに表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周订阅与月订阅会自动续期，可随时在“管理订阅”中取消；日卡与永久版为一次性购买。价格由 App Store 按地区展示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週訂閱與月訂閱會自動續期，可隨時在「管理訂閱」中取消；日卡與永久版為一次性購買。價格由 App Store 按地區顯示。"
          }
        }
      }
    },
    "mac.quota.pro": {
      "extractionState": "manual",

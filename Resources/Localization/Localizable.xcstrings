    "pro.legal.purchase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are shown by the App Store for your region and take effect once verified. The day pass and lifetime unlock are one-time purchases; weekly and monthly subscriptions renew automatically and can be cancelled anytime in your system subscription settings, staying active until the current period ends."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格は App Store が地域ごとに表示し、取引の検証後に有効になります。デイパスと永久アンロックは買い切り、週・月サブスクリプションは自動更新で、システムの「サブスクリプション」からいつでも解約できます。解約後も現在の期間が終わるまでは有効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格由 App Store 按当前地区显示，交易验证通过后才生效。日卡与永久解锁为一次性购买；周订阅与月订阅会自动续期，可随时在系统「订阅」中取消，取消后当前周期结束前仍然有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "價格由 App Store 按目前地區顯示，交易驗證通過後才生效。日卡與永久解鎖為一次性購買；週訂閱與月訂閱會自動續期，可隨時在系統「訂閱」中取消，取消後目前週期結束前仍然有效。"
          }
        }
      }
    },
    "pro.legal.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are always processed on device. Purchase and trial records never upload photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は常に本機で処理されます。購入・体験の記録が写真をアップロードすることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片始终只在本机处理，购买与试用记录不上传照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片始終只在本機處理，購買與試用記錄不上傳照片。"
          }
        }
      }
    },

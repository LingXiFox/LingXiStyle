    "batch.convertAvailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert %lld only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 枚だけ変換"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅转换 %lld 张"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅轉換 %lld 張"
          }
        }
      }
    },
    "batch.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You selected %lld convertible photos and have %lld free conversions left today. The rest will be skipped and won't use quota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 枚の変換可能な写真を選択しました。本日の無料枠は残り %lld 枚です。超過分は変換されず、枠も消費しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选 %lld 张可转换照片，今日还剩 %lld 张免费额度。超出部分不会转换，也不会消耗额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選 %lld 張可轉換照片，今日還剩 %lld 張免費額度。超出部分不會轉換，也不會消耗額度。"
          }
        }
      }
    },

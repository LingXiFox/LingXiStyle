    },
    "不购买也可以继续使用免费额度。转换质量与完整性校验完全一致。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep using the free allowance without buying. Conversion quality and integrity checks are exactly the same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入しなくても無料枠を使えます。変換品質と完全性の検証は購入後とまったく同じです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不购买也可以继续使用免费额度。转换质量与完整性校验完全一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不購買也可以繼續使用免費額度。轉換品質與完整性校驗完全一致。"
          }
        }
      }
    },
    "为 HEIC 原片追加第三代 Texture / Grain，并另存为新照片。原图保持不变。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds third-generation texture and grain to HEIC originals and saves a new photo. The original stays untouched."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC 原本に第3世代のテクスチャ／グレインを追加し、新しい写真として保存します。元の写真は変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
